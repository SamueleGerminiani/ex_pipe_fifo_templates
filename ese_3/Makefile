
CFLAGS=-Wall -std=gnu99
INCLUDES=-I./inc

RECORD_SRCS=src/errExit.c src/report.c src/main.c
ENGINE_SRCS=src/moves.c src/engine.c

RECORD_OBJS=$(RECORD_SRCS:.c=.o)
ENGINE_OBJS=$(ENGINE_SRCS:.c=.o)
SRCS=$(sort $(RECORD_SRCS) $(ENGINE_SRCS))
OBJS=$(SRCS:.c=.o)

all: record engine

record: $(RECORD_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

engine: $(ENGINE_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

.c.o:
	@echo "Compiling: "$<
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# compile_commands.json tells the editor how each file is compiled
# (include paths, flags): generated by make itself, before compiling
$(OBJS): | compile_commands.json

compile_commands.json: Makefile
	@echo "Generating: "$@
	@sep=""; printf "[" > $@; \
	for src in $(SRCS); do \
		printf '%s\n  {"directory": "%s", "file": "%s", "command": "%s"}' "$$sep" \
			"$(CURDIR)" "$$src" "$(CC) $(CFLAGS) $(INCLUDES) -c $$src -o $${src%.c}.o" >> $@; \
		sep=","; \
	done; \
	printf '\n]\n' >> $@

.PHONY: all clean

clean:
	@rm -f src/*.o record engine
	@echo "Removed object files and executables..."


CFLAGS=-Wall -std=gnu99
INCLUDES=-I./inc

HINTS_SRCS=src/errExit.c src/moves.c src/hints.c src/server.c
ASK_SRCS=src/errExit.c src/moves.c src/hints.c src/report.c src/client.c

HINTS_OBJS=$(HINTS_SRCS:.c=.o)
ASK_OBJS=$(ASK_SRCS:.c=.o)
SRCS=$(sort $(HINTS_SRCS) $(ASK_SRCS))
OBJS=$(SRCS:.c=.o)

all: hints ask

hints: $(HINTS_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

ask: $(ASK_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

.c.o:
	@echo "Compiling: "$<
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# compile_commands.json tells the editor how each file is compiled
# (include paths, flags): generated by make itself, before compiling
$(OBJS): | compile_commands.json

compile_commands.json: Makefile
	@echo "Generating: "$@
	@sep=""; printf "[" > $@; \
	for src in $(SRCS); do \
		printf '%s\n  {"directory": "%s", "file": "%s", "command": "%s"}' "$$sep" \
			"$(CURDIR)" "$$src" "$(CC) $(CFLAGS) $(INCLUDES) -c $$src -o $${src%.c}.o" >> $@; \
		sep=","; \
	done; \
	printf '\n]\n' >> $@

.PHONY: all clean

clean:
	@rm -f src/*.o hints ask hints.fifo hint_reply.*
	@echo "Removed object files and executables..."

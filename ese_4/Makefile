
CFLAGS=-Wall -std=gnu99
INCLUDES=-I./inc

FEED_SRCS=src/errExit.c src/report.c src/feed.c
MOVE_SRCS=src/errExit.c src/move.c

FEED_OBJS=$(FEED_SRCS:.c=.o)
MOVE_OBJS=$(MOVE_SRCS:.c=.o)
SRCS=$(sort $(FEED_SRCS) $(MOVE_SRCS))
OBJS=$(SRCS:.c=.o)

all: feed move

feed: $(FEED_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

move: $(MOVE_OBJS)
	@echo "Making executable: "$@
	@$(CC) $^ -o $@

.c.o:
	@echo "Compiling: "$<
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

# compile_commands.json tells the editor how each file is compiled
# (include paths, flags): generated by make itself, before compiling
$(OBJS): | compile_commands.json

compile_commands.json: Makefile
	@echo "Generating: "$@
	@sep=""; printf "[" > $@; \
	for src in $(SRCS); do \
		printf '%s\n  {"directory": "%s", "file": "%s", "command": "%s"}' "$$sep" \
			"$(CURDIR)" "$$src" "$(CC) $(CFLAGS) $(INCLUDES) -c $$src -o $${src%.c}.o" >> $@; \
		sep=","; \
	done; \
	printf '\n]\n' >> $@

.PHONY: all clean

clean:
	@rm -f src/*.o feed move arena.fifo
	@echo "Removed object files and executables..."
